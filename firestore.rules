rules_version = '2';

// ---------------------------------------------------------------------------
// Firestore security rules — THIS is what actually protects your data.
//
// Plain English: a signed-in user may read and write ONLY documents that live
// under their own users/{their-own-id}/... path. Nobody can read or write
// anyone else's mental health, fitness, or finance entries. Signed-out
// requests are denied entirely.
//
// Deploy these (see backend/README.md):
//   firebase deploy --only firestore:rules
// Until you deploy, the database uses Firebase's default rules, which may block
// everything or (in test mode) allow everything — so deploy these on day one.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user owns everything under their own user document.
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Everything else is denied by default (no rule = no access).
  }
}
